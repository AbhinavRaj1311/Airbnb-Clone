{
  "name": "staygallery",
  "version": "1.0.0",
  "description": "StayGallery - An original MERN implementation of a production-quality vacation rental listing experience",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "install:all": "npm install && npm install --workspace=client && npm install --workspace=server",
    "seed": "npm run seed --workspace=server",
    "lint": "npm run lint --workspace=client",
    "test": "npm run test --workspace=client",
    "download-assets": "node scripts/download-assets.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
